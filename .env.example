# Copy to .env.local and fill in. Never commit the filled copy.

# Origin serving the transcoded recipe videos (no trailing slash).
#
# The .mp4/.webm files are gitignored — 65 MB of media does not belong in
# the repo — so production points this at a CDN or bucket:
#
#   NEXT_PUBLIC_MEDIA_BASE_URL=https://media.aliciabasurto.com
#
# Left empty, video URLs resolve to /video/… under apps/web/public/, which
# is what a local checkout has after running:
#
#   node scripts/transcode-videos.mjs
#
# Poster frames are committed and never routed through this base, so the
# /videos grid renders either way. See apps/web/src/lib/media.ts.
NEXT_PUBLIC_MEDIA_BASE_URL=
